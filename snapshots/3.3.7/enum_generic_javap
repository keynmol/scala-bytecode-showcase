import compiler.iface.Snapshot

@Snapshot
      enum Option[+T]:
        case Some(value: T)
        case None

@Snapshot
      def getOrElse[T](opt: Option[T], default: T): T =
        opt match
          case Option.Some(v) => v
          case Option.None => default

