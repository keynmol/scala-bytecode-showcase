import compiler.iface.Snapshot

@Snapshot
      def pythagorean(n: Int): List[(Int, Int, Int)] =
        for
          a <- (1 to n).toList
          b <- (a to n).toList
          c <- (b to n).toList
          if a * a + b * b == c * c
        yield (a, b, c)

@Snapshot
      def run: List[(Int, Int, Int)] =
        pythagorean(15)

