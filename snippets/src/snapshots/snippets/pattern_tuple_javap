import compiler.iface.Snapshot

@Snapshot
      def processPair(pair: (Int, String)): String =
        pair match
          case (0, s) => s"zero with $s"
          case (n, "special") => s"$n is special"
          case (n, s) => s"$n and $s"

@Snapshot
      def run: String =
        List(
          processPair((0, "hello")),
          processPair((42, "special")),
          processPair((7, "world"))
        ).mkString("; ")

